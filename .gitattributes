# Shell scripts must keep LF endings: a CRLF checkout fails with
# "syntax error near unexpected token `$'{\r''" when the server runs them.
*.sh text eol=lf

# Binary assets stay byte-exact for release checksums.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.wasm binary
*.pfb binary
*.ttf binary
*.jks binary
*.7z binary

# Locked third-party resources must match vendor-lock.json on every platform.
clients/frontend/vendor/** -text

# Barcode decoding resources are verified byte-for-byte by their lock.
static/vendor/asset-tools/** -text

# Public Bootstrap copies use the same locked bytes as the client vendor.
static/vendor/bootstrap/** -text
static/vendor/bootstrap-icons/** -text
