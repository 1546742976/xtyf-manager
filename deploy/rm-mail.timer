[Unit]
Description=Check XTYF mail queue promptly after each worker finishes
# Morning/evening windows are enforced in the worker (Asia/Shanghai).
# Verification/test jobs have priority and can be sent at any hour.

[Timer]
OnBootSec=60s
OnUnitInactiveSec=60s
AccuracySec=1s
Unit=rm-mail.service

[Install]
WantedBy=timers.target
