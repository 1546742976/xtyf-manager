# Installed as /etc/xtyf-manager/mail.env by deploy/install_mail.py; never commit credentials.
# Both the website and mail worker must receive these environment variables.
# This file is not loaded automatically by Python or the Windows preview server.
MAIL_MODE=off
PUBLIC_BASE_URL=
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_TLS=ssl
# Use the full @163.com address for both values.
SMTP_USERNAME=
SMTP_FROM=
# Enter the 163 client authorization code locally, not the web-login password.
SMTP_PASSWORD=
