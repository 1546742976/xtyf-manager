# systemd 服务模板：deploy.sh 安装时用 sed 替换 {{APP_USER}} / {{APP_DIR}} 占位符
[Unit]
Description=RoboMaster Progress Tracker (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User={{APP_USER}}
WorkingDirectory={{APP_DIR}}
Environment=PYTHONUNBUFFERED=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# 默认 1 worker / 8 线程；配置钩子在服务重启后自动接续持久化发票队列
ExecStart={{APP_DIR}}/venv/bin/gunicorn --config deploy/gunicorn.conf.py --workers 1 --threads 8 --timeout 120 --bind 0.0.0.0:80 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
