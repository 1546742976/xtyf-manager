# systemd 服务模板：deploy.sh 安装时用 sed 替换 {{APP_USER}} / {{APP_DIR}} 占位符
[Unit]
Description=RoboMaster Progress Tracker (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User={{APP_USER}}
WorkingDirectory={{APP_DIR}}
Environment=PYTHONUNBUFFERED=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# 关键：单 worker（发票 SSE 后台任务依赖进程内状态）；8 线程；绑定 80 端口（配合 AmbientCapabilities）
ExecStart={{APP_DIR}}/venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 0.0.0.0:80 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
