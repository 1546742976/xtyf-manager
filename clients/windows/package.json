{
  "name": "xtyf-manager-client",
  "version": "1.0.0",
  "description": "巡天御风管理系统 Windows 客户端",
  "author": "巡天御风",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test client.test.cjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "online.skywalker.manager",
    "productName": "巡天御风管理系统",
    "artifactName": "XTYF-Manager-Setup-${version}-${arch}.${ext}",
    "directories": { "output": "../../dist/clients/windows" },
    "files": ["main.cjs", "preload.cjs", "url.cjs", "settings.html", "settings.js", "config.json"],
    "win": { "target": "nsis", "icon": "icon.ico", "signExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": ["zh_CN", "en_US"],
      "displayLanguageSelector": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
